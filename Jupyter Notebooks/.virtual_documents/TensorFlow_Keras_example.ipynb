


from IPython.display import Markdown as md
import matplotlib.pyplot as plt
import os
import random as rd
import numpy as np

import tensorflow as tf
from tensorflow.keras import layers

source_path = "C:\\Python39\\Lib\\site-packages"
os.chdir(source_path)


(x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()





x_train = x_train/255
# y_train = y_train/255

x_test = x_test/255
# y_test = y_test/255


# Let's see how the data looks like so far
print("x_train = ", x_train.shape)
print("y_train = ", y_train.shape)

rand = rd.randint(0, x_train.shape[0])

# Print out one of the training datapoints using the matplotlib module
plt.imshow(x_train[rand], cmap='Greys')
plt.title("Image #" + str(rand))





model_lr = tf.keras.models.Sequential([
    layers.Input(x_train.shape[1:]),
    layers.Flatten(),
    layers.Dense(10, activation="softmax")
])

model_lr.compile(optimizer='adam', loss='categorical_crossentropy', metrics=['accuracy'])
model_lr.summary()


print(x_train.shape[1:])








# These lines are commented because there's a better option to solve this problem in the cells bellow.
# y_onehot_train = tf.one_hot(indices=y_train, depth=10)
# model_lr.fit(x_train, y_onehot_train)





model_lr.compile(optimizer="adam", loss="sparse_categorical_crossentropy", metrics=['accuracy'])
model_lr.summary()





# Run 1
# model_lr.fit(x_train, y_train)








# Run 2
# model_lr.fit(x_train, y_train)


# Run 3
# model_lr.fit(x_train, y_train)





# model_lr.fit(x_train, y_train, epochs=10, batch_size=128, validation_split=0.2)


history_lr = model_lr.fit(x_train, y_train, epochs=10, batch_size=128, validation_data=(x_test, y_test), verbose=False)


plt.plot(history_lr.history['loss'], label='train')
plt.plot(history_lr.history['val_loss'], label='val')
plt.ylabel('loss')
plt.legend()
plt.show()

plt.plot(history_lr.history['accuracy'], label='train')
plt.plot(history_lr.history['val_accuracy'], label='val')
plt.ylabel('accuracy')
plt.legend()
plt.show()





(lr_loss, lr_accuracy) = model_lr.evaluate(x_test, y_test)
ref_val_accuracy = history_lr.history['val_accuracy'][len(history_lr.history['val_accuracy']) - 1]
ref_val_loss = history_lr.history['val_loss'][len(history_lr.history['val_loss']) - 1]

loss_ratio = round((((ref_val_loss - lr_loss)/ref_val_loss) * 100), 4)
accuracy_ratio = ((ref_val_accuracy - lr_accuracy)/ref_val_accuracy) * 100

md(f"The previous command used the validation set as input for the evaluation methods. One run of this *evaluate* on top of the validation data yielded `[loss={str(lr_loss)}, accuracy={str(lr_accuracy)}]`. \
A quick look at the *history_lr* variable obtained before shows that the last elements for both the val_accuracy and val_loss arrays are, respectively: ref_val_accuracy = {ref_val_accuracy} and ref_val_loss = {ref_val_loss}. \
Accuracy wise, it is a complete match: accuracy_ratio = ((ref_val_accuracy - lr_accuracy)/ref_val_accuracy) * 100 = {accuracy_ratio}%. \
The loss fuction diverges, but not by a lot: loss_ratio = ((ref_val_loss - lr_loss)/ref_val_loss) * 100 = {loss_ratio}%")





